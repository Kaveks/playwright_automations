# Copy this file to `.env` and fill in the values:
#
#   cp .env.example .env
#
# `.env` is git-ignored and must never be committed. In CI these same names are
# supplied from the repository's Actions secrets instead of from a file.

# --- saucedemo.com (Swag Labs) ---------------------------------------------
# Credentials for the standard happy-path account.
SAUCEDEMO_USER=
SAUCEDEMO_PASSWORD=

# Optional. The blocked account used by the negative sign-in test.
# Defaults to `locked_out_user` when unset, so it needs no CI secret.
# SAUCEDEMO_LOCKED_OUT_USER=
